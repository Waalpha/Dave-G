rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Platform Settings & SaaS Configurations
    match /platformSettings/{settingId} {
      allow read, write: if true;
    }

    match /platformSubscriptionPlans/{planId} {
      allow read, write: if true;
    }

    // Tenant Management & Routing
    match /tenants/{tenantId} {
      allow read, write: if true;
    }

    match /tenantDomains/{domainId} {
      allow read, write: if true;
    }

    // Users & RBAC
    match /users/{userId} {
      allow read, write: if true;
    }

    // System Logs & Notifications
    match /auditLogs/{logId} {
      allow read, write: if true;
    }

    match /notifications/{notifId} {
      allow read, write: if true;
    }

    // ==========================================
    // Education & Campus Management Collections
    // ==========================================
    match /campuses/{campusId} {
      allow read, write: if true;
    }

    match /academicYears/{yearId} {
      allow read, write: if true;
    }

    match /terms/{termId} {
      allow read, write: if true;
    }

    match /departments/{deptId} {
      allow read, write: if true;
    }

    match /programs/{programId} {
      allow read, write: if true;
    }

    match /units/{unitId} {
      allow read, write: if true;
    }

    match /schoolClasses/{classId} {
      allow read, write: if true;
    }

    match /students/{studentId} {
      allow read, write: if true;
    }

    match /staff/{staffId} {
      allow read, write: if true;
    }

    match /timetable/{entryId} {
      allow read, write: if true;
    }

    match /studentAttendance/{attId} {
      allow read, write: if true;
    }

    match /feeStructures/{feeId} {
      allow read, write: if true;
    }

    match /studentInvoices/{invId} {
      allow read, write: if true;
    }

    match /feePayments/{paymentId} {
      allow read, write: if true;
    }

    match /studentGrades/{gradeId} {
      allow read, write: if true;
    }

    match /libraryBooks/{bookId} {
      allow read, write: if true;
    }

    match /libraryLoans/{loanId} {
      allow read, write: if true;
    }

    match /hostelRooms/{roomId} {
      allow read, write: if true;
    }

    match /enrollments/{enrollmentId} {
      allow read, write: if true;
    }

    // ==========================================
    // Industry Modules (SACCO, POS, Retail, HR, CRM)
    // ==========================================
    match /chamaMembers/{memberId} {
      allow read, write: if true;
    }

    match /chamaContributions/{contribId} {
      allow read, write: if true;
    }

    match /chamaLoans/{loanId} {
      allow read, write: if true;
    }

    match /chamaRepayments/{repayId} {
      allow read, write: if true;
    }

    match /chamaInvestments/{invId} {
      allow read, write: if true;
    }

    match /posProducts/{productId} {
      allow read, write: if true;
    }

    match /posSales/{saleId} {
      allow read, write: if true;
    }

    match /restaurantTables/{tableId} {
      allow read, write: if true;
    }

    match /restaurantMenu/{menuId} {
      allow read, write: if true;
    }

    match /inventoryMovements/{moveId} {
      allow read, write: if true;
    }

    match /accountingLedger/{ledgerId} {
      allow read, write: if true;
    }

    match /employees/{empId} {
      allow read, write: if true;
    }

    match /crmLeads/{leadId} {
      allow read, write: if true;
    }

    match /churchMembers/{memberId} {
      allow read, write: if true;
    }

    match /churchGivings/{givingId} {
      allow read, write: if true;
    }

    // ==========================================
    // Healthcare & Hospital Management Collections
    // ==========================================
    match /healthcarePatients/{id} {
      allow read, write: if true;
    }

    match /healthcarePatientContacts/{id} {
      allow read, write: if true;
    }

    match /healthcarePatientDocuments/{id} {
      allow read, write: if true;
    }

    match /healthcareDepartments/{id} {
      allow read, write: if true;
    }

    match /healthcareStaff/{id} {
      allow read, write: if true;
    }

    match /healthcareStaffShifts/{id} {
      allow read, write: if true;
    }

    match /healthcareAppointments/{id} {
      allow read, write: if true;
    }

    match /healthcareQueues/{id} {
      allow read, write: if true;
    }

    match /healthcareTriages/{id} {
      allow read, write: if true;
    }

    match /healthcareEncounters/{id} {
      allow read, write: if true;
    }

    match /healthcareVitals/{id} {
      allow read, write: if true;
    }

    match /healthcareDiagnoses/{id} {
      allow read, write: if true;
    }

    match /healthcareTreatmentPlans/{id} {
      allow read, write: if true;
    }

    match /healthcareProcedures/{id} {
      allow read, write: if true;
    }

    match /healthcarePrescriptions/{id} {
      allow read, write: if true;
    }

    match /healthcarePrescriptionItems/{id} {
      allow read, write: if true;
    }

    match /healthcareMedicines/{id} {
      allow read, write: if true;
    }

    match /healthcareMedicineBatches/{id} {
      allow read, write: if true;
    }

    match /healthcarePharmacyDispenses/{id} {
      allow read, write: if true;
    }

    match /healthcarePharmacyTransactions/{id} {
      allow read, write: if true;
    }

    match /healthcareLabTests/{id} {
      allow read, write: if true;
    }

    match /healthcareLabRequests/{id} {
      allow read, write: if true;
    }

    match /healthcareLabSamples/{id} {
      allow read, write: if true;
    }

    match /healthcareLabResults/{id} {
      allow read, write: if true;
    }

    match /healthcareRadiologyServices/{id} {
      allow read, write: if true;
    }

    match /healthcareRadiologyRequests/{id} {
      allow read, write: if true;
    }

    match /healthcareRadiologyReports/{id} {
      allow read, write: if true;
    }

    match /healthcareWards/{id} {
      allow read, write: if true;
    }

    match /healthcareRooms/{id} {
      allow read, write: if true;
    }

    match /healthcareBeds/{id} {
      allow read, write: if true;
    }

    match /healthcareAdmissions/{id} {
      allow read, write: if true;
    }

    match /healthcareNursingCare/{id} {
      allow read, write: if true;
    }

    match /healthcareNursingRecords/{id} {
      allow read, write: if true;
    }

    match /healthcareMedAdministrations/{id} {
      allow read, write: if true;
    }

    match /healthcareMedicationAdministration/{id} {
      allow read, write: if true;
    }

    match /healthcareTheatreRooms/{id} {
      allow read, write: if true;
    }

    match /healthcareTheatres/{id} {
      allow read, write: if true;
    }

    match /healthcareTheatreSurgeries/{id} {
      allow read, write: if true;
    }

    match /healthcareSurgeries/{id} {
      allow read, write: if true;
    }

    match /healthcareInvoices/{id} {
      allow read, write: if true;
    }

    match /healthcareInvoiceItems/{id} {
      allow read, write: if true;
    }

    match /healthcarePayments/{id} {
      allow read, write: if true;
    }

    match /healthcareInsuranceProviders/{id} {
      allow read, write: if true;
    }

    match /healthcareInsuranceMembers/{id} {
      allow read, write: if true;
    }

    match /healthcareInsuranceClaims/{id} {
      allow read, write: if true;
    }

    match /healthcareSuppliers/{id} {
      allow read, write: if true;
    }

    match /healthcareInventory/{id} {
      allow read, write: if true;
    }

    match /healthcareInventoryItems/{id} {
      allow read, write: if true;
    }

    match /healthcareStockTransactions/{id} {
      allow read, write: if true;
    }

    match /healthcareAmbulances/{id} {
      allow read, write: if true;
    }

    match /healthcareAmbulanceTrips/{id} {
      allow read, write: if true;
    }

    match /healthcareBloodDonors/{id} {
      allow read, write: if true;
    }

    match /healthcareBloodUnits/{id} {
      allow read, write: if true;
    }

    match /healthcareBloodTransfusions/{id} {
      allow read, write: if true;
    }

    match /healthcareMortuary/{id} {
      allow read, write: if true;
    }

    // ==========================================
    // Centralized Printers & Receipts Collections
    // ==========================================
    match /printers/{printerId} {
      allow read, write: if true;
    }

    match /universalReceipts/{receiptId} {
      allow read, write: if true;
    }

    match /printJobs/{jobId} {
      allow read, write: if true;
    }

    match /printerAuditLogs/{logId} {
      allow read, write: if true;
    }

    // Default safety net for unmapped paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
