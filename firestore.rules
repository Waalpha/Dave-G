rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Master safety net default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Platform Settings: readable by all, writable
    match /platformSettings/{settingId} {
      allow read, write: if true;
    }

    // Tenants: readable and writable for tenant provisioning & updating
    match /tenants/{tenantId} {
      allow read, write: if true;
    }

    // Users: readable and writable for user management & RBAC
    match /users/{userId} {
      allow read, write: if true;
    }

    // Operational tenant collections
    match /departments/{deptId} {
      allow read, write: if true;
    }

    match /programs/{programId} {
      allow read, write: if true;
    }

    match /campuses/{campusId} {
      allow read, write: if true;
    }

    match /students/{studentId} {
      allow read, write: if true;
    }

    match /feePayments/{paymentId} {
      allow read, write: if true;
    }

    match /academicYears/{yearId} {
      allow read, write: if true;
    }

    match /terms/{termId} {
      allow read, write: if true;
    }

    match /units/{unitId} {
      allow read, write: if true;
    }

    match /staff/{staffId} {
      allow read, write: if true;
    }

    match /timetable/{entryId} {
      allow read, write: if true;
    }

    match /enrollments/{enrollmentId} {
      allow read, write: if true;
    }

    match /auditLogs/{logId} {
      allow read, write: if true;
    }

    match /notifications/{notifId} {
      allow read, write: if true;
    }

    // Industry modules
    match /chamaMembers/{memberId} {
      allow read, write: if true;
    }

    match /chamaContributions/{contribId} {
      allow read, write: if true;
    }

    match /chamaLoans/{loanId} {
      allow read, write: if true;
    }

    match /chamaRepayments/{repayId} {
      allow read, write: if true;
    }

    match /chamaInvestments/{invId} {
      allow read, write: if true;
    }

    match /posProducts/{productId} {
      allow read, write: if true;
    }

    match /posSales/{saleId} {
      allow read, write: if true;
    }

    match /restaurantTables/{tableId} {
      allow read, write: if true;
    }

    match /restaurantMenu/{menuId} {
      allow read, write: if true;
    }

    match /inventoryMovements/{moveId} {
      allow read, write: if true;
    }

    match /accountingLedger/{ledgerId} {
      allow read, write: if true;
    }

    match /employees/{empId} {
      allow read, write: if true;
    }

    match /crmLeads/{leadId} {
      allow read, write: if true;
    }

    match /churchMembers/{memberId} {
      allow read, write: if true;
    }

    match /churchGivings/{givingId} {
      allow read, write: if true;
    }
  }
}
